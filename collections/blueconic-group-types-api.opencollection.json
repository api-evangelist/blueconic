{
  "opencollection": "1.0.0",
  "info": {
    "name": "BlueConic REST API v2 Audit Events Group Types API",
    "version": "100.0"
  },
  "items": [
    {
      "info": {
        "name": "Group Types",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves all types of groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{blueconicHostname}/rest/v2/groupTypes",
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/rest/v2/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves all group types."
        }
      ]
    }
  ],
  "bundled": true
}